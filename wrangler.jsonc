/**
 * FORKING THIS? Seven lines are ours and have to become yours:
 *
 *   routes[]            the domain patterns — or delete the block entirely and
 *                       the Worker answers on its own workers.dev address
 *   vars.MAIL_FROM      the address your instance sends from
 *   vars.GOOGLE_CLIENT_IDS  your own OAuth client ids, or "" to turn Google
 *                       sign-in off (the app hides the button either way)
 *   d1_databases[0].database_id   from `wrangler d1 create opentv`
 *   kv_namespaces[0].id           from `wrangler kv namespace create CACHE`
 *   kv_namespaces[1].id           from `wrangler kv namespace create OAUTH_KV`
 *   vars.MCP_ORIGIN     your Worker's public origin (Claude/ChatGPT connect to it + /mcp)
 *
 * The ids left here are this deployment's. They are identifiers, not
 * credentials — nothing reaches them without a Cloudflare API token for this
 * account — but they are also not yours, so change them or your deploy will
 * fail against a database you cannot see.
 *
 * SECRETS ARE NEVER IN THIS FILE. `wrangler secret put` for production,
 * `.dev.vars` (gitignored) locally. See README.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentv-api",
  // src/worker.ts puts the OAuth provider (Claude and ChatGPT, 2.3.0) in front
  // of src/index.ts, which is still the whole API. See the header of worker.ts.
  "main": "src/worker.ts",
  // 2026-07-30 is the installed workerd's ceiling (1.20260730.1); a later date
  // makes `wrangler dev` error on every start.
  "compatibility_date": "2026-07-30",
  // node:buffer, for base64url handling of JWT segments in Step 1.
  // global_fetch_strictly_public (2.3.0): the OAuth library fetches Client ID
  // Metadata Documents from URLs a client names (ChatGPT signs in that way);
  // this keeps those fetches on the public internet, never same-zone routing.
  // Without it the library stops advertising CIMD and ChatGPT cannot connect.
  // It applies to every outbound fetch, and every one this Worker makes is to a
  // public API (Apple, Google, RevenueCat, Resend, CommsUni, TMDB), so nothing else changes.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  /*
   * `theopentv.com/@handle` — the public profile page, and ONLY that shape.
   *
   * A narrow pattern on purpose. The marketing site answers every path on this
   * domain, including ones that do not exist, so a broad route would quietly
   * take the whole site over and nobody would notice until a page went missing.
   * `/@*` can only ever match a profile link.
   *
   * The API keeps its own hostname. This route adds a public face to the same
   * Worker; it does not move anything.
   */
  /*
   * TRUE, AND NOT OPTIONAL. Declaring `routes` makes wrangler default
   * `workers_dev` to FALSE, which silently switched off
   * opentv-api.mahmoodbashar08.workers.dev -- the host every shipped app has
   * baked into API_BASE_URL. The edge answered `error code: 1042` and the app
   * could reach nothing. Adding a public page must not take the API offline.
   */
  "workers_dev": true,
  // Two shapes, both narrow. A list card on a profile links to /list/<id>, and
  // that path was going to the marketing site -- which answers 200 for anything,
  // so the link looked like it worked and served the wrong page.
  /*
   * dashboard.theopentv.com — the admin page on a name that can be typed.
   *
   * A WHOLE SUBDOMAIN, unlike the two patterns above, and safe to take because
   * nothing else serves it: the marketing site is the apex, so a route here
   * cannot swallow a page somebody else owns. `/*` rather than
   * `/admin/dashboard` so the sign-in POSTs to /v1/admin/... land on the same
   * origin as the page — the session is an HttpOnly cookie, and a cross-origin
   * form would need CORS opened to carry it.
   *
   * It needs a DNS record to exist for the subdomain (an orange-clouded A or
   * CNAME to anything — Cloudflare answers it before the origin is reached).
   * A route without a record resolves nowhere.
   */
  "routes": [
    { "pattern": "theopentv.com/@*", "zone_name": "theopentv.com" },
    { "pattern": "theopentv.com/list/*", "zone_name": "theopentv.com" },
    { "pattern": "dashboard.theopentv.com/*", "zone_name": "theopentv.com" }
  ],

  // The night shift — docs/IMPLEMENTATION.md Step 5. 04:00 UTC is the trough
  // for a user base concentrated in Europe and the Middle East.
  "triggers": { "crons": ["0 4 * * *"] },

  // Cloudflare Email Sending. A binding, not a key: `mail.ts` sends through it
  // when it is present and falls back to Resend when only RESEND_API_KEY is.
  // The from-domain must be onboarded first: `wrangler email sending enable theopentv.com`.
  "send_email": [{ "name": "EMAIL" }],

  // Public identifiers only — they appear in every client binary anyway.
  // Secrets (SESSION_SECRET, RC_WEBHOOK_SECRET) go in with `wrangler secret
  // put` and never live here. Locally they come from .dev.vars.
  "vars": {
    "APPLE_BUNDLE_ID": "com.insightfy.opentv",
    // The sending address. Not a secret — it is what every recipient reads.
    // Sent through the EMAIL binding above; RESEND_API_KEY is only the fallback.
    "MAIL_FROM": "OpenTV <noreply@theopentv.com>",
    // "off" closes email SIGN-UP while 1.3.1 is in review — see env.ts. Sign-in
    // stays open, and Apple and Google are unaffected. Set back to "on".
    "EMAIL_SIGNUP": "on",
    // The address people paste into Claude and ChatGPT is this + "/mcp", and
    // every OAuth token is bound to it, so it must be the public origin exactly
    // (no trailing slash). For `wrangler dev`, override in .dev.vars:
    // MCP_ORIGIN=http://localhost:8787
    "MCP_ORIGIN": "https://opentv-api.mahmoodbashar08.workers.dev",
    // Comma-separated: iOS, Android and **Web** client ids. Android sign-in
    // returns the *web* client id as `aud`, which is the classic trap. Filled
    // in when Google sign-in is wired up in the app; empty means every Google
    // token is refused, which is the correct direction to fail.
    "GOOGLE_CLIENT_IDS": "452943907676-p8tdhcpv1kfe92t8nf07vf6g5ao2m0mf.apps.googleusercontent.com,452943907676-vf096glumrms1bna4dcjhrtjo61f5kd1.apps.googleusercontent.com,452943907676-e39h1tgethjivr4eg5ao2n4i0hg2245d.apps.googleusercontent.com,452943907676-b3ekb99d8i5jgsbue2ndhc0hqqtmmf9q.apps.googleusercontent.com"
  },

  // The social layer. Nothing a user owns is stored here — see docs/PLAN.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opentv",
      // Filled in by: wrangler d1 create opentv
      "database_id": "872adbe7-4735-4ef6-8cd2-620e443b1fbd",
      "migrations_dir": "migrations"
    }
  ],

  // Translating comments, and nothing else. See routes/translate.ts for why
  // this runs here rather than at a translation vendor.
  "ai": { "binding": "AI" },

  /*
   * The live room (2.0.0) — one Durable Object per episode-night, see
   * src/rooms.ts. SQLite-backed, as Cloudflare recommends for every new class
   * and as the Free plan requires. The migration tag is this Worker's first:
   * a later change to the class (a rename, a delete) appends v2, never edits v1.
   */
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "EpisodeRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EpisodeRoom"] }],

  // Caches provider JWKS so token verification does not fetch on every request.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "b87a5a9f72d345b5931ac00e34d17c61" },
    // The OAuth library's store for Claude and ChatGPT (2.3.0): registered
    // clients, grants, hashed tokens, props encrypted under the token. Its own
    // namespace so `CACHE` can be flushed without signing everybody out.
    // created 3 Nov 2026 with `wrangler kv namespace create OAUTH_KV`
    // and paste the id here. Deploy fails until then.
    { "binding": "OAUTH_KV", "id": "252fdc03253d46cabe0bc2f38e413efc" }
  ],

  // Rescued TV Time comment photos. TV Time's CDN
  // (d12qk6n9ersps4.cloudfront.net) no longer resolves, so the only surviving
  // copies are the ones OpenTV downloaded to users' phones at import time —
  // this is where they are preserved. Nothing is SERVED from here until
  // `comment_images.scan_status` says 'clean'; see migration 0001.
  //
  // Profile pictures are the one thing here that IS served back out — see the
  // header of src/routes/avatars.ts, and the scanning caveat in it.
  "r2_buckets": [
    { "binding": "COMMENT_IMAGES", "bucket_name": "opentv-comment-images" },
    { "binding": "AVATARS", "bucket_name": "opentv-avatars" },
    // Opt-in library backups for Plus. One opaque ZIP per profile, never read
    // by this server — see the header of src/routes/backup.ts.
    { "binding": "BACKUPS", "bucket_name": "opentv-backups" }
  ]
}
